<Window x:Class="OptikLentera.Win7.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
 Title="OPTIK LENTERA | Desktop" Icon="/Assets/optik_lentera_launcher_emblem.png" Height="820" Width="1300"
 MinHeight="680" MinWidth="1024" WindowStartupLocation="CenterScreen"
 Background="#F5F1E8" FontFamily="Segoe UI">
 <Window.Resources>
  <Style x:Key="NavButton" TargetType="Button">
   <Setter Property="Height" Value="48"/><Setter Property="Margin" Value="0,3,0,3"/>
   <Setter Property="Padding" Value="16,0"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#D9D3C7"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ContentPresenter VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#30302D"/><Setter Property="Foreground" Value="#E5C987"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Background" Value="#403A2E"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="MetricCard" TargetType="Border">
   <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="13"/>
   <Setter Property="Padding" Value="20"/><Setter Property="Margin" Value="0,0,14,0"/>
   <Setter Property="BorderBrush" Value="#ECE6DA"/><Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style TargetType="TextBox">
   <Setter Property="Height" Value="35"/>
   <Setter Property="Padding" Value="10,7"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="#292823"/>
   <Setter Property="Background" Value="#FFFEFC"/>
   <Setter Property="BorderBrush" Value="#DED6C8"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="DataGrid">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="#302E29"/>
   <Setter Property="GridLinesVisibility" Value="Horizontal"/>
   <Setter Property="HorizontalGridLinesBrush" Value="#EEE8DD"/>
   <Setter Property="AlternatingRowBackground" Value="#FAF8F3"/>
   <Setter Property="RowBackground" Value="White"/>
   <Setter Property="CanUserResizeRows" Value="False"/>
   <Setter Property="HeadersVisibility" Value="Column"/>
   <Setter Property="ColumnHeaderHeight" Value="36"/>
   <Setter Property="RowHeight" Value="34"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style TargetType="DataGridColumnHeader">
   <Setter Property="Background" Value="#F2EBDD"/>
   <Setter Property="Foreground" Value="#67583C"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="9,6"/>
   <Setter Property="BorderBrush" Value="#E4DCCF"/>
   <Setter Property="BorderThickness" Value="0,0,0,1"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="258"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="#181917">
   <DockPanel Margin="20,18">
    <StackPanel DockPanel.Dock="Top" Margin="0,7,0,24">
     <Border Width="196" Height="104" Background="Transparent" HorizontalAlignment="Center" Margin="0,0,0,8">
      <Image Source="/Assets/optik_lentera_app_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
     </Border>
     <TextBlock Text="OPTIK LENTERA" Foreground="#F7F3EA" FontSize="19" FontWeight="Bold" Margin="0,13,0,2"/>
     <TextBlock Text="DESKTOP WORKSPACE" Foreground="#C8A45D" FontSize="10" FontWeight="SemiBold"/>
    </StackPanel>
    <StackPanel>
     <TextBlock Text="RUANG KERJA" Foreground="#8C877D" FontSize="10" FontWeight="Bold" Margin="10,0,0,8"/>
     <Button Style="{StaticResource NavButton}" Tag="Dashboard" Click="Navigate_Click" Background="#343027" Foreground="#E5C987"><TextBlock Text="▦   Dashboard"/></Button>
     <Button Style="{StaticResource NavButton}" Tag="Pelanggan" Click="Navigate_Click"><TextBlock Text="♙   Pelanggan"/></Button>
     <Button Style="{StaticResource NavButton}" Tag="Pemeriksaan Mata" Click="Navigate_Click"><TextBlock Text="◉   Pemeriksaan Mata"/></Button>
     <TextBlock Text="TRANSAKSI" Foreground="#8C877D" FontSize="10" FontWeight="Bold" Margin="10,16,0,8"/>
     <Button Style="{StaticResource NavButton}" Tag="Pesanan" Click="Navigate_Click"><TextBlock Text="▤   Pesanan"/></Button>
     <Button Style="{StaticResource NavButton}" Tag="Pembayaran" Click="Navigate_Click"><TextBlock Text="◇   Pembayaran"/></Button>
     <Button Style="{StaticResource NavButton}" Tag="Invoice &amp; Kuitansi" Click="Navigate_Click"><TextBlock Text="▧   Invoice &amp; Kuitansi"/></Button>
     <TextBlock Text="RINGKASAN" Foreground="#8C877D" FontSize="10" FontWeight="Bold" Margin="10,16,0,8"/>
     <Button Style="{StaticResource NavButton}" Tag="Laporan" Click="Navigate_Click"><TextBlock Text="▥   Laporan"/></Button>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="0,20,0,4">
     <Border Height="1" Background="#393832" Margin="0,0,0,14"/>
     <TextBlock Text="MODE DESKTOP" Foreground="#C8A45D" FontSize="10" FontWeight="Bold"/>
     <TextBlock Text="Data lokal • Offline" Foreground="#AAA49A" FontSize="11" Margin="0,5,0,0"/>
     <TextBlock Text="OPTIK LENTERA  |  WINDOWS" Foreground="#77736B" FontSize="10" Margin="0,16,0,0"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="34,28,34,28">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Grid Grid.Row="0" Margin="0,0,0,24">
    <StackPanel><TextBlock Text="WORKSPACE" Foreground="#A18A5C" FontSize="10" FontWeight="Bold" />
     <TextBlock x:Name="PageTitle" Text="Dashboard" Foreground="#20201E" FontSize="29" FontWeight="Bold" Margin="0,6,0,0"/>
     <TextBlock x:Name="PageSubtitle" Text="Ringkasan aktivitas OPTIK LENTERA" Foreground="#817C72" FontSize="12" Margin="0,4,0,0"/>
    </StackPanel>
    <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="#FFFEFC" BorderBrush="#E4D8C2" BorderThickness="1" CornerRadius="20" Padding="14,8">
     <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#C8A45D" Margin="0,0,8,0"/><TextBlock Text="DESKTOP  •  OFFLINE" Foreground="#67583C" FontSize="10" FontWeight="SemiBold"/></StackPanel>
    </Border>
   </Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel x:Name="DashboardContent">
     <Border Background="#20211F" CornerRadius="18" Padding="28" Margin="0,0,0,20" BorderBrush="#B99550" BorderThickness="1">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
        <Border Background="#393326" CornerRadius="12" Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,14">
         <TextBlock Text="WORKSPACE OPTIK • WINDOWS" Foreground="#E6C982" FontSize="9" FontWeight="Bold" />
        </Border>
        <TextBlock Text="JELAS LIHATNYA," Foreground="#F7F3EA" FontSize="25" FontWeight="Bold"/>
        <TextBlock Text="JELAS REJEKINYA." Foreground="#E6C982" FontSize="25" FontWeight="Bold" Margin="0,-2,0,0"/>
        <TextBlock Text="Kelola pelayanan optik dengan lebih rapi, nyaman, dan profesional." Foreground="#E7E2D8" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"/>
        <TextBlock Text="Mode desktop offline • Data tersimpan di komputer ini" Foreground="#B9B2A5" FontSize="10" Margin="0,18,0,0"/>
       </StackPanel>
       <Border Grid.Column="1" Background="#292923" CornerRadius="16" Padding="14" VerticalAlignment="Center">
        <Image Source="/Assets/optik_lentera_app_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Opacity="1"/>
       </Border>
      </Grid>
     </Border>
     <primitives:UniformGrid Columns="3" Margin="0,0,0,20">
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="PELANGGAN" Foreground="#8A847A" FontSize="10" FontWeight="Bold"/><TextBlock Text="--" Foreground="#24231F" FontSize="30" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="Data belum dihubungkan" Foreground="#9A948A" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="PESANAN AKTIF" Foreground="#8A847A" FontSize="10" FontWeight="Bold"/><TextBlock Text="--" Foreground="#24231F" FontSize="30" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="Data belum dihubungkan" Foreground="#9A948A" FontSize="11"/></StackPanel></Border>
      <Border Style="{StaticResource MetricCard}"><StackPanel><TextBlock Text="PEMBAYARAN" Foreground="#8A847A" FontSize="10" FontWeight="Bold"/><TextBlock Text="--" Foreground="#24231F" FontSize="30" FontWeight="Bold" Margin="0,8,0,2"/><TextBlock Text="Data belum dihubungkan" Foreground="#9A948A" FontSize="11"/></StackPanel></Border>
     </primitives:UniformGrid>
     <Border Background="White" BorderBrush="#ECE6DA" BorderThickness="1" CornerRadius="13" Padding="22">
      <StackPanel><TextBlock Text="PERSIAPAN UJI COBA" Foreground="#292823" FontSize="15" FontWeight="Bold" Margin="0,0,0,12"/>
       <TextBlock Text="✓  Aplikasi desktop Windows mandiri" Foreground="#5D665D" FontSize="12" Margin="0,4"/>
       <TextBlock Text="✓  Data contoh lokal, tidak menyentuh Google Sheets" Foreground="#5D665D" FontSize="12" Margin="0,4"/>
       <TextBlock Text="✓  Navigasi menu dasar dapat diuji" Foreground="#5D665D" FontSize="12" Margin="0,4"/>
       <TextBlock Text="○  Koneksi Android dan sinkronisasi belum diaktifkan" Foreground="#8A847A" FontSize="12" Margin="0,4"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>