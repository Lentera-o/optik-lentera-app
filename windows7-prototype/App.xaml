<Application x:Class="OptikLentera.Win7.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
 <Application.Resources>
  <Color x:Key="Ink">#171717</Color>
  <Color x:Key="Gold">#C8A45D</Color>
  <Color x:Key="Cream">#F7F3EA</Color>
  <Color x:Key="Muted">#77736B</Color>
  <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}"/>
  <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold}"/>
  <SolidColorBrush x:Key="CreamBrush" Color="{StaticResource Cream}"/>
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}"/>
 </Application.Resources>
</Application>